{
  "extends": "../libtmux/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "lib": ["ES2024", "ESNext.Disposable", "DOM"],
    "sourceMap": true,
    "isolatedDeclarations": false,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
