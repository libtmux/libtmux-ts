{
  "name": "@libtmux/mcp",
  "version": "0.1.0-alpha.7",
  "description": "Model Context Protocol server for tmux, built on libtmux.",
  "keywords": [
    "agent",
    "libtmux",
    "mcp",
    "model-context-protocol",
    "terminal",
    "tmux"
  ],
  "homepage": "https://github.com/libtmux/libtmux-ts/tree/master/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/libtmux/libtmux-ts/issues"
  },
  "license": "MIT",
  "author": "Tony Narlock <tony@git-pull.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libtmux/libtmux-ts.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "libtmux-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && bun scripts/run-tests.ts",
    "test:package": "bun run build && bun ../../scripts/check-source-maps.ts && bun ../../scripts/check-package-analysis.ts",
    "test:install": "bun run build && bun ../../scripts/check-consumer-install.ts packages/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "libtmux": "0.1.0-alpha.7",
    "zod": "4.5.4"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
