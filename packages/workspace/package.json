{
  "name": "@libtmux/workspace",
  "version": "0.1.0-alpha.6",
  "description": "Declarative tmux workspace builder, built on libtmux.",
  "keywords": [
    "libtmux",
    "session",
    "terminal",
    "tmux",
    "tmuxp",
    "workspace"
  ],
  "homepage": "https://github.com/libtmux/libtmux-ts/tree/master/packages/workspace#readme",
  "bugs": {
    "url": "https://github.com/libtmux/libtmux-ts/issues"
  },
  "license": "MIT",
  "author": "Tony Narlock <tony@git-pull.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libtmux/libtmux-ts.git",
    "directory": "packages/workspace"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/builder.js",
  "types": "./dist/builder.d.ts",
  "exports": {
    ".": {
      "types": "./dist/builder.d.ts",
      "bun": "./src/builder.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "bun": "./src/config.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json",
    "./ownership": {
      "types": "./dist/ownership.d.ts",
      "bun": "./src/ownership.ts",
      "import": "./dist/ownership.js",
      "default": "./dist/ownership.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --no-orphans tests",
    "test:package": "bun run build && bun ../../scripts/check-source-maps.ts && bun ../../scripts/check-package-analysis.ts",
    "test:install": "bun run build && bun ../../scripts/check-consumer-install.ts packages/workspace"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "libtmux": "0.1.0-alpha.6"
  },
  "peerDependencies": {
    "libtmux": "0.1.0-alpha.6"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
