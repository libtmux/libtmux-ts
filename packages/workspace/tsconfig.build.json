{
  "extends": "../libtmux/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "sourceMap": true,
    "isolatedDeclarations": false,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
