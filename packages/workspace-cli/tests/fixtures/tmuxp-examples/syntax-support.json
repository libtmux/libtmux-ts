{
  "source": "What the workspace loader does with the keys and forms of tmuxp's workspace syntax. Each probe is read as /workspace/w.yaml with HOME set to /home/u; tests/tmuxp-structure.test.ts checks every entry against the loader, so the record changes when the loader does. Adapted from libtmux-ruby's record of its own loader, with the statuses measured on this one.",
  "statuses": {
    "supported": "Accepted and means what tmuxp means.",
    "difference": "Accepted, with the recorded difference.",
    "refused": "Refused with the recorded message."
  },
  "entries": [
    {
      "id": "session-name",
      "scope": "session",
      "key": "session_name",
      "form": "string",
      "probe": ["session_name: a", "windows:", "  - window_name: w", "    panes: [{}]"],
      "status": "supported"
    },
    {
      "id": "windows",
      "scope": "session",
      "key": "windows",
      "form": "nonempty list of windows",
      "probe": ["session_name: a", "windows:", "  - window_name: w", "    panes: [{}]"],
      "status": "supported"
    },
    {
      "id": "session-start-directory-absolute",
      "scope": "session",
      "key": "start_directory",
      "form": "absolute path",
      "probe": [
        "session_name: a",
        "start_directory: /var/log",
        "windows:",
        "  - window_name: w",
        "    panes: [{}]"
      ],
      "status": "supported",
      "observed": { "path": ["directory"], "value": "/var/log" }
    },
    {
      "id": "start-directory-relative",
      "scope": "window",
      "key": "start_directory",
      "form": "relative path",
      "probe": [
        "session_name: a",
        "start_directory: /var",
        "windows:",
        "  - window_name: w",
        "    start_directory: log",
        "    panes: [{}]"
      ],
      "status": "supported",
      "observed": { "path": ["windows", 0, "directory"], "value": "/var/log" }
    },
    {
      "id": "start-directory-tilde",
      "scope": "session",
      "key": "start_directory",
      "form": "leading ~",
      "probe": [
        "session_name: a",
        "start_directory: ~/x",
        "windows:",
        "  - window_name: w",
        "    panes: [{}]"
      ],
      "status": "supported",
      "observed": { "path": ["directory"], "value": "/home/u/x" }
    },
    {
      "id": "variable-expansion-default",
      "scope": "session",
      "key": "${VAR}",
      "form": "environment variable in a value",
      "probe": [
        "session_name: a",
        "start_directory: ${HOME}/x",
        "windows:",
        "  - window_name: w",
        "    panes: [{}]"
      ],
      "status": "supported",
      "observed": { "path": ["directory"], "value": "/home/u/x" }
    },
    {
      "id": "environment-strings",
      "scope": "session",
      "key": "environment",
      "form": "mapping of strings",
      "probe": [
        "session_name: a",
        "environment:",
        "  A: b",
        "windows:",
        "  - window_name: w",
        "    panes: [{}]"
      ],
      "status": "supported"
    },
    {
      "id": "environment-other-values",
      "scope": "session",
      "key": "environment",
      "form": "number or other non-string value",
      "probe": [
        "session_name: a",
        "environment:",
        "  A: 1",
        "windows:",
        "  - window_name: w",
        "    panes: [{}]"
      ],
      "status": "refused",
      "message": "environment.A must be a string"
    },
    {
      "id": "session-shell-command-before",
      "scope": "session",
