        { "focus": false, "start_directory": "${HOME}", "environment": {}, "commands": ["top"] },
        {
          "focus": false,
          "start_directory": "${HOME}",
          "environment": {},
          "commands": ["echo \"hey\""]
        },
        {
          "focus": false,
          "start_directory": "${HOME}",
          "environment": {},
          "commands": ["echo \"moo\""]
        }
      ]
    }
  ]
