{
  "name": "@libtmux/workspace-cli",
  "version": "0.1.0-alpha.8",
  "description": "A tmuxp-compatible workspace manager for Node and Bun.",
  "license": "MIT",
  "bin": {
    "tmux-workspace": "./dist/main.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/main.ts --target node --outdir dist --splitting --external libtmux",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests",
    "test:install": "bun run build && bun scripts/check-install.ts"
  },
  "devDependencies": {
    "cli-truncate": "6.1.1",
    "commander": "15.0.0",
    "libtmux": "0.1.0-alpha.8",
    "string-width": "8.2.2",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "libtmux": "0.1.0-alpha.8"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  }
}
