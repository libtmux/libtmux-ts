{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "node", "promise", "unicorn"],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "ignorePatterns": ["**/dist/**"],
  "options": {
    "typeAware": true,
    "typeCheck": false,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/await-thenable": "off"
  }
}
